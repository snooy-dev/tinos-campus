<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectGuid>{0F30118B-4288-469F-91AB-E305AA50CC08}</ProjectGuid>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</RepoRoot>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <VcpkgEnabled>false</VcpkgEnabled>
    <ProbeDependencies>$(RepoRoot)build\serialization-probe\vcpkg_installed\x64-windows\</ProbeDependencies>
    <DependencyConfig Condition="'$(Configuration)'=='Debug'">debug\</DependencyConfig>
    <RttrLibrary Condition="'$(Configuration)'=='Debug'">rttr_core_d.lib</RttrLibrary>
    <RttrLibrary Condition="'$(Configuration)'=='Release'">rttr_core.lib</RttrLibrary>
    <OutDir>$(RepoRoot)build\serialization-probe\$(Configuration)\</OutDir>
    <IntDir>$(OutDir)obj\</IntDir>
    <TargetName>SerializationProbe</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp23</LanguageStandard>
      <ScanSourceForModuleDependencies>true</ScanSourceForModuleDependencies>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level3</WarningLevel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalOptions>/utf-8 /Zc:preprocessor %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(ProbeDependencies)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>RTTR_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;RTTR_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;RTTR_DLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalLibraryDirectories>$(ProbeDependencies)$(DependencyConfig)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(RttrLibrary);%(AdditionalDependencies)</AdditionalDependencies>
      <OptimizeReferences Condition="'$(Configuration)'=='Release'">true</OptimizeReferences>
      <EnableCOMDATFolding Condition="'$(Configuration)'=='Release'">true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(RepoRoot)engine\framework\transform.ixx" />
    <ClCompile Include="model.ixx" />
    <ClCompile Include="registration.cpp" />
    <ClCompile Include="codec.cpp" />
    <ClCompile Include="probe.cpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="CopyProbeRuntime" AfterTargets="Build">
    <ItemGroup><RuntimeDll Include="$(ProbeDependencies)$(DependencyConfig)bin\*.dll" /></ItemGroup>
    <Copy SourceFiles="@(RuntimeDll)" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
